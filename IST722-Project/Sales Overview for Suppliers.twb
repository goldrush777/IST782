      <column caption='Region' datatype='string' name='[Calculation_5421208053235310594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5421208053225181184] IN (&quot;MA&quot;, &quot;PA&quot;, &quot;NY&quot;, &quot;NH&quot;, &quot;NJ&quot;, &quot;CT&quot;, &quot;VT&quot;, &quot;MD&quot;, &quot;DC&quot;) THEN &quot;Northeast&quot;&#10;ELSEIF [Calculation_5421208053225181184] IN (&quot;SC&quot;, &quot;NC&quot;, &quot;GA&quot;, &quot;FL&quot;, &quot;VA&quot;, &quot;TX&quot;) THEN &quot;Southeast&quot;&#10;ELSEIF [Calculation_5421208053225181184] IN (&quot;KY&quot;, &quot;IL&quot;, &quot;IN&quot;, &quot;OH&quot;) THEN &quot;Midwest&quot;&#10;ELSEIF [Calculation_5421208053225181184] = &quot;CA&quot; THEN &quot;California&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
